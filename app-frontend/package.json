{
  "name": "unum-ide",
  "private": true,
  "version": "0.1.0",
  "description": "Unum IDE desktop development environment",
  "homepage": "https://github.com/sebashuesca/Unum",
  "author": {
    "name": "sebas",
    "email": "sebasrex154@gmail.com"
  },
  "desktopName": "unum-ide",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm run electron:dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build && wait-on http://127.0.0.1:5173 && electron .",
    "build": "tsc -b && npm run electron:build && vite build",
    "package:linux": "node scripts/package.mjs linux",
    "package:win": "node scripts/package.mjs win",
    "start": "electron .",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.unum.ide",
    "productName": "Unum IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "extraResources": [
        {
          "from": "resources/bin/win",
          "to": "backend",
          "filter": [
            "unum-backend.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "icon": "public/icon.png",
      "extraResources": [
        {
          "from": "resources/bin/linux",
          "to": "backend",
          "filter": [
            "unum-backend"
          ]
        }
      ]
    }
  }
}
